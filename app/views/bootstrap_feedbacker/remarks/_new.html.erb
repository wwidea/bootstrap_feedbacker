<div data-controller="bootstrap-feedbacker--remarks">
  <div
    class="modal fade"
    tabindex="-1"
    aria-labelledby="modalFeedbackLabel"
    aria-hidden="true"
    data-bootstrap-feedbacker--remarks-target="modal"
  >
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5" id="modalFeedbackLabel"><%= t(".title") %></h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <%= tag.div(id: BootstrapFeedbacker::SETTINGS.modal_content_id) do %>
          <%= render("form") %>
        <% end %>
      </div>
    </div>
  </div>
</div>
