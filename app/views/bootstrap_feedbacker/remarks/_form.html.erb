<%= form_for(@remark) do |f| %>
  <div class="modal-body">
    <div class="mb-2">
      <%= t(".greeting") %>
    </div>
    <%= f.text_area(:content, class: "form-control") %>
  </div>
  <div class="modal-footer">
    <%= render("close_button") %>
    <%= f.submit("Submit Feedback", class: "btn btn-success") %>
  </div>
<% end %>
